<mxCell id="manager" value="&lt;b&gt;Quản lý cửa hàng&lt;/b&gt;&lt;br&gt;[Person]" style="html=1;whiteSpace=wrap;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="70" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="web" value="&lt;b&gt;Web App&lt;/b&gt;&lt;br&gt;[Container: Next.js, React, PWA]&lt;br&gt;&lt;br&gt;Giao diện mobile-first/PWA: menu, giỏ hàng, đặt đơn,&lt;br&gt;trang kết quả thanh toán (Return URL),&lt;br&gt;màn hình quầy cho nhân viên/quản lý" style="html=1;whiteSpace=wrap;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="190" y="250" width="560" height="140" as="geometry"/></mxCell>
<mxCell id="api" value="&lt;b&gt;API Application&lt;/b&gt;&lt;br&gt;[Container: NestJS, TypeScript]&lt;br&gt;&lt;br&gt;REST API theo module/domain: xác thực JWT, phân quyền,&lt;br&gt;menu, giỏ hàng, đơn, tồn kho, thanh toán VNPay,&lt;br&gt;IPN, đối soát, health check, logging" style="html=1;whiteSpace=wrap;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="190" y="520" width="560" height="150" as="geometry"/></mxCell>
<mxCell id="db" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL]&lt;br&gt;&lt;br&gt;User, Product, ProductOption, Cart, CartItem,&lt;br&gt;Order, OrderItem, Payment;&lt;br&gt;lược đồ quản lý bằng migration" style="html=1;whiteSpace=wrap;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="190" y="790" width="560" height="150" as="geometry"/></mxCell>
<mxCell id="vnpay" value="&lt;b&gt;VNPay Sandbox&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;Payment Service mô phỏng:&lt;br&gt;trang thanh toán thử nghiệm,&lt;br&gt;Return URL, IPN, QueryDR" style="html=1;whiteSpace=wrap;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="1080" y="500" width="300" height="160" as="geometry"/></mxCell>
<mxCell id="legend" value="&lt;b&gt;Chú thích&lt;/b&gt;&lt;br&gt;Khung nét đứt lớn: ranh giới hệ thống BrewLite&lt;br&gt;Khung nét liền: container (đơn vị chạy/triển khai được)&lt;br&gt;[External System]: hệ thống bên ngoài, nằm ngoài ranh giới&lt;br&gt;Mũi tên nét liền: lời gọi giữa các thành phần&lt;br&gt;Mũi tên nét đứt: chuyển hướng trình duyệt (redirect)&lt;br&gt;Nhãn: mục đích [giao thức]" style="html=1;whiteSpace=wrap;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="920" y="760" width="460" height="132" as="geometry"/></mxCell>
