<mxfile host="app.diagrams.net" type="device"><diagram id="activity-expiry" name="3. Xử lý Payment hết hạn và luồng thanh toán lại"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2720" pageHeight="2750"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="3. Xử lý Payment hết hạn và luồng thanh toán lại (Activity Expiry)" style="text;html=0;fontFamily=Arial;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="2680" height="50" as="geometry" /></mxCell><mxCell id="lane_cus" value="Khách hàng" style="swimlane;html=0;startSize=55;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=top;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="420" height="2640" as="geometry" /></mxCell><mxCell id="lane_ui" value="Next.js UI" style="swimlane;html=0;startSize=55;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=top;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="80" width="460" height="2640" as="geometry" /></mxCell><mxCell id="lane_api" value="NestJS API" style="swimlane;html=0;startSize=55;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=top;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="80" width="720" height="2640" as="geometry" /></mxCell><mxCell id="lane_db" value="Database" style="swimlane;html=0;startSize=55;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=top;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1620" y="80" width="560" height="2640" as="geometry" /></mxCell><mxCell id="lane_vnp" value="VNPay Sandbox «Payment Service»" style="swimlane;html=0;startSize=55;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=top;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2180" y="80" width="520" height="2640" as="geometry" /></mxCell><mxCell id="start_cron" value="" style="fontFamily=Arial;shape=ellipse;fillColor=#111111;strokeColor=#111111;" vertex="1" parent="1"><mxGeometry x="1246" y="166" width="28" height="28" as="geometry" /></mxCell><mxCell id="cron_trigger" value="NestJS Cron Job kích hoạt định kỳ (ví dụ: mỗi 1 phút)" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1050" y="230" width="420" height="75" as="geometry" /></mxCell><mxCell id="m_cron_query" value="" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1245" y="335" width="30" height="30" as="geometry" /></mxCell><mxCell id="cron_query_db" value="Quét danh sách Payment có Payment.status = PENDING AND expiresAt &lt;= NOW()" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1030" y="395" width="460" height="75" as="geometry" /></mxCell><mxCell id="dec_has_expired" value="Còn bản ghi hết hạn?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1110" y="500" width="300" height="85" as="geometry" /></mxCell><mxCell id="end_cron" value="" style="fontFamily=Arial;shape=doubleEllipse;fillColor=#111111;strokeColor=#111111;" vertex="1" parent="1"><mxGeometry x="1520" y="528" width="28" height="28" as="geometry" /></mxCell><mxCell id="select_p" value="Lấy Payment P tiếp theo; kiểm tra trạng thái mới nhất" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1050" y="615" width="420" height="75" as="geometry" /></mxCell><mxCell id="dec_p_status" value="Trạng thái Payment P?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1020" y="715" width="260" height="95" as="geometry" /></mxCell><mxCell id="skip_paid" value="Payment đã SUCCESS qua IPN: bỏ qua; không xử lý hết hạn; KHÔNG hoàn tồn" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1370" y="720" width="250" height="85" as="geometry" /></mxCell><mxCell id="vnp_query_dr" value="Gửi truy vấn QueryDR sang VNPay Sandbox để đối soát trạng thái giao dịch" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1040" y="855" width="440" height="75" as="geometry" /></mxCell><mxCell id="vnp_handle_dr" value="VNPay Sandbox tra cứu log giao dịch thử nghiệm và phản hồi kết quả" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2240" y="855" width="400" height="75" as="geometry" /></mxCell><mxCell id="dec_dr_outcome" value="Kết quả QueryDR từ Sandbox?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1110" y="940" width="300" height="85" as="geometry" /></mxCell><mxCell id="m_unknown_keep" value="" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1245" y="1045" width="30" height="30" as="geometry" /></mxCell><mxCell id="vnp_unknown_keep" value="Chưa rõ kết quả / Timeout: Payment = UNKNOWN (hoặc PENDING); giữ Order PENDING_PAYMENT; KHÔNG hoàn tồn" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1020" y="1100" width="480" height="85" as="geometry" /></mxCell><mxCell id="late_success_check" value="Nếu sau đó nhận kết quả SUCCESS: cập nhật Payment = SUCCESS, Order = PAID; KHÔNG hoàn tồn" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1040" y="1215" width="440" height="80" as="geometry" /></mxCell><mxCell id="db_begin_expiry" value="Mở DB Transaction; khóa Order và Payment để xử lý hết hạn" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1680" y="1100" width="440" height="75" as="geometry" /></mxCell><mxCell id="dec_safe_refund" value="Chưa hoàn tồn &amp; đủ điều kiện?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1750" y="1205" width="300" height="85" as="geometry" /></mxCell><mxCell id="skip_already_refund" value="Đã được hoàn tồn trước đó: bỏ qua; không hoàn tồn lần hai" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1280" y="1320" width="340" height="80" as="geometry" /></mxCell><mxCell id="db_refund_stock" value="Cộng hoàn lại tồn kho theo Product đúng một lần; cập nhật Payment = EXPIRED; giữ Order PENDING_PAYMENT" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1660" y="1315" width="480" height="90" as="geometry" /></mxCell><mxCell id="db_commit_expiry" value="COMMIT Transaction (ghi nhận dấu hoàn tồn và kết quả hết hạn)" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1670" y="1435" width="460" height="75" as="geometry" /></mxCell><mxCell id="m_loop_db" value="" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="940" y="1435" width="30" height="30" as="geometry" /></mxCell><mxCell id="m_loop_mid" value="" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="940" y="1240" width="30" height="30" as="geometry" /></mxCell><mxCell id="m_loop_top" value="" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="940" y="747" width="30" height="30" as="geometry" /></mxCell><mxCell id="start_retry" value="" style="fontFamily=Arial;shape=ellipse;fillColor=#111111;strokeColor=#111111;" vertex="1" parent="1"><mxGeometry x="216" y="1510" width="28" height="28" as="geometry" /></mxCell><mxCell id="cus_see_pending" value="Khách hàng thấy đơn cũ vẫn ở trạng thái PENDING_PAYMENT; bấm Thanh toán lại" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="1580" width="360" height="85" as="geometry" /></mxCell><mxCell id="ui_retry_req" value="Sinh Idempotency-Key mới; gửi POST /orders/:id/payments (thanh toán lại đơn cũ) kèm JWT" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="480" y="1580" width="380" height="85" as="geometry" /></mxCell><mxCell id="api_retry_calc" value="Tính lại tổng tiền từ bảng giá hiện hành; mở DB Transaction kiểm tra tồn kho Product" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1040" y="1580" width="440" height="85" as="geometry" /></mxCell><mxCell id="dec_retry_stock" value="Đủ tồn kho cho đơn thanh toán lại?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1090" y="1690" width="340" height="95" as="geometry" /></mxCell><mxCell id="api_retry_out" value="Từ chối thanh toán lại; ROLLBACK tx; không tạo Payment; thông báo món đồ uống đã hết hàng" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1040" y="1805" width="440" height="85" as="geometry" /></mxCell><mxCell id="ui_retry_out_msg" value="Hiển thị thông báo hết hàng; yêu cầu khách chọn món khác" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="480" y="1805" width="380" height="80" as="geometry" /></mxCell><mxCell id="end_retry_out" value="" style="fontFamily=Arial;shape=doubleEllipse;fillColor=#111111;strokeColor=#111111;" vertex="1" parent="1"><mxGeometry x="656" y="1915" width="28" height="28" as="geometry" /></mxCell><mxCell id="db_retry_hold" value="Trừ tồn kho theo Product; tạo bản ghi Payment MỚI (status = PENDING, mã mới, key mới, hạn 15 phút); COMMIT tx" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1660" y="1695" width="480" height="90" as="geometry" /></mxCell><mxCell id="api_retry_url" value="Tạo URL VNPay Sandbox mới có thời hạn 15 phút kèm chữ ký bảo mật; đóng DB connection" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1040" y="1995" width="440" height="80" as="geometry" /></mxCell><mxCell id="ui_retry_redirect" value="Chuyển hướng trình duyệt khách hàng sang cổng VNPay Sandbox để thanh toán lại" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="480" y="2110" width="380" height="85" as="geometry" /></mxCell><mxCell id="vnp_retry_page" value="VNPay Sandbox tiếp nhận giao dịch thanh toán lại mới" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2230" y="2110" width="400" height="85" as="geometry" /></mxCell><mxCell id="end_retry" value="" style="fontFamily=Arial;shape=doubleEllipse;fillColor=#111111;strokeColor=#111111;" vertex="1" parent="1"><mxGeometry x="2416" y="2235" width="28" height="28" as="geometry" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#111111;strokeWidth=2.2;fontFamily=Arial;fontSize=14;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start_cron" target="cron_trigger"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#111111;strokeWidth=2.2;fontFamily=Arial;fontSize=14;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cron_trigger" target="m_cron_query"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_query_go" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#111111;strokeWidth=2.2;fontFamily=Arial;fontSize=14;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m_cron_query" target="cron_query_db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#111111;strokeWidth=2.2;fontFamily=Arial;fontSize=14;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cron_query_db" target="dec_has_expired"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="Hết" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#111111;strokeWidth=2.2;fontFamily=Arial;fontSize=14;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec_has_expired" target="end_cron"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-18" as="offset" /></mxGeometry></mxCell><mxCell id="e4" value="Còn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#111111;strokeWidth=2.2;fontFamily=Arial;fontSize=14;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec_has_expired" target="select_p"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="0" as="off