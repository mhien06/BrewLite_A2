<mxCell id="customer" value="Khách hàng&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Xem menu, đặt đơn,&lt;br&gt;thanh toán, theo dõi đơn,&lt;br&gt;nhận đồ tại quầy" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="260" height="130" as="geometry"/></mxCell>
<mxCell id="staff" value="Nhân viên quầy&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Xem đơn, cập nhật&lt;br&gt;tiến độ chuẩn bị/bàn giao" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="60" width="240" height="130" as="geometry"/></mxCell>
<mxCell id="manager" value="Quản lý cửa hàng&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Theo dõi, xử lý đơn&lt;br&gt;theo quyền hạn" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="240" height="130" as="geometry"/></mxCell>
<mxCell id="brewlite" value="BrewLite&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Ứng dụng đặt đồ uống cho một&lt;br&gt;cửa hàng: menu, giỏ hàng, đặt&lt;br&gt;đơn, tồn kho theo Product,&lt;br&gt;thanh toán thử nghiệm, xử lý&lt;br&gt;đơn tại quầy" style="rounded=0;strokeWidth=3;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="360" height="170" as="geometry"/></mxCell>
<mxCell id="vnpay" value="VNPay Sandbox&lt;br&gt;[Software System – bên ngoài]&lt;br&gt;&lt;br&gt;Payment Service mô phỏng:&lt;br&gt;trang thanh toán thử nghiệm,&lt;br&gt;Return URL, IPN, QueryDR.&lt;br&gt;Không có giao dịch tiền thật" style="rounded=0;dashed=1;strokeWidth=2;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="580" width="360" height="150" as="geometry"/></mxCell>
<mxCell id="legend" value="Chú thích&lt;br&gt;Khung nét liền đậm: hệ thống đang xây dựng (BrewLite)&lt;br&gt;Khung nét đứt: hệ thống bên ngoài&lt;br&gt;Khung bo góc: người dùng (Person)&lt;br&gt;Mũi tên: hướng khởi tạo tương tác, nhãn ghi mục đích/giao thức" style="align=left;verticalAlign=top;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=9;spacing=6;" vertex="1" parent="1"><mxGeometry x="980" y="60" width="360" height="160" as="geometry"/></mxCell>
<mxCell id="e0" value="Xem menu, đặt đơn, thanh toán,&lt;br&gt;xem trạng thái đơn [HTTPS]" style="endArrow=block;html=1;strokeColor=#000000;fontColor=#000000;fontSize=9;" edge="1" parent="1" source="customer" target="brewlite"><mxGeometry relative="1" as="geometry"/></mxCell>
