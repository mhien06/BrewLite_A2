<mxCell id="title" value="BrewLite – C4 Level 1: System Context" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1340" height="32" as="geometry"/></mxCell>
<mxCell id="customer" value="&lt;b&gt;Khách hàng&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Xem menu, chọn size/topping, đặt đơn,&lt;br&gt;thanh toán và theo dõi đơn,&lt;br&gt;nhận đồ uống tại quầy" style="html=1;whiteSpace=wrap;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="80" width="330" height="126" as="geometry"/></mxCell>
<mxCell id="staff" value="&lt;b&gt;Nhân viên quầy&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Xem đơn của cửa hàng,&lt;br&gt;cập nhật tiến độ chuẩn bị/bàn giao" style="html=1;whiteSpace=wrap;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="80" width="310" height="126" as="geometry"/></mxCell>
<mxCell id="manager" value="&lt;b&gt;Quản lý cửa hàng&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Theo dõi và xử lý đơn&lt;br&gt;theo quyền hạn" style="html=1;whiteSpace=wrap;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;rounded=1;arcSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="80" width="310" height="126" as="geometry"/></mxCell>
<mxCell id="brewlite" value="&lt;b&gt;BrewLite&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Ứng dụng đặt đồ uống trực tuyến cho một cửa hàng:&lt;br&gt;menu, giỏ hàng, đặt đơn, tồn kho theo Product,&lt;br&gt;thanh toán thử nghiệm và xử lý đơn tại quầy" style="html=1;whiteSpace=wrap;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=2.5;fontSize=12;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="420" y="340" width="520" height="150" as="geometry"/></mxCell>
<mxCell id="vnpay" value="&lt;b&gt;VNPay Sandbox&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;Payment Service mô phỏng: trang thanh toán thử nghiệm,&lt;br&gt;Return URL, IPN, QueryDR. Không có giao dịch tiền thật" style="html=1;whiteSpace=wrap;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="420" y="660" width="520" height="130" as="geometry"/></mxCell>
<mxCell id="legend" value="&lt;b&gt;Chú thích&lt;/b&gt;&lt;br&gt;[Person]: người dùng hệ thống&lt;br&gt;[Software System]: hệ thống đang xây dựng&lt;br&gt;[External System]: hệ thống bên ngoài BrewLite&lt;br&gt;Mũi tên nét liền: tương tác, nhãn ghi mục đích [giao thức]&lt;br&gt;Mũi tên nét đứt hai chiều: thao tác qua trình duyệt" style="html=1;whiteSpace=wrap;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;strokeWidth=1;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="990" y="660" width="380" height="112" as="geometry"/></mxCell>
<mxCell id="r1" value="Xem menu, đặt đơn,&lt;br&gt;xem trạng thái đơn [HTTPS]" style="html=1;rounded=0;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=8;exitX=0.4848;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="customer" target="brewlite"><mxGeometry x="-0.4454" relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="415"/></Array></mxGeometry></mxCell>
