<mxfile host="app.diagrams.net" type="device"><diagram id="activity-payment" name="2. Chi tiết xử lý thanh toán"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2720" pageHeight="2950"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="2. Chi tiết xử lý thanh toán VNPay Sandbox (Activity Payment)" style="text;html=0;fontFamily=Arial;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="2680" height="50" as="geometry" /></mxCell><mxCell id="lane_cus" value="Khách hàng" style="swimlane;html=0;startSize=55;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=top;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="420" height="2840" as="geometry" /></mxCell><mxCell id="lane_ui" value="Next.js UI" style="swimlane;html=0;startSize=55;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=top;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="80" width="480" height="2840" as="geometry" /></mxCell><mxCell id="lane_api" value="NestJS API" style="swimlane;html=0;startSize=55;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=top;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="920" y="80" width="720" height="2840" as="geometry" /></mxCell><mxCell id="lane_db" value="Database" style="swimlane;html=0;startSize=55;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=top;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1640" y="80" width="540" height="2840" as="geometry" /></mxCell><mxCell id="lane_vnp" value="VNPay Sandbox «Payment Service»" style="swimlane;html=0;startSize=55;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=top;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2180" y="80" width="520" height="2840" as="geometry" /></mxCell><mxCell id="start_pay" value="" style="fontFamily=Arial;shape=ellipse;fillColor=#111111;strokeColor=#111111;" vertex="1" parent="1"><mxGeometry x="216" y="166" width="28" height="28" as="geometry" /></mxCell><mxCell id="cus_select_pay" value="Chọn phương thức VNPay Sandbox; bấm Thanh toán đơn hàng" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="230" width="360" height="75" as="geometry" /></mxCell><mxCell id="ui_gen_key" value="Sinh Idempotency-Key (UUIDv4); gửi POST /orders/:id/payments kèm JWT" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="480" y="230" width="400" height="75" as="geometry" /></mxCell><mxCell id="api_auth_check" value="Xác thực JWT &amp; quyền sở hữu Order?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1270" y="335" width="300" height="85" as="geometry" /></mxCell><mxCell id="api_query_key" value="Kiểm tra Idempotency-Key trong DB Cache/Table" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1240" y="445" width="360" height="70" as="geometry" /></mxCell><mxCell id="dec_key_exist" value="Key đã tồn tại?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1270" y="540" width="300" height="85" as="geometry" /></mxCell><mxCell id="api_query_order" value="Truy vấn Order và kiểm tra trạng thái thanh toán" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1240" y="650" width="360" height="70" as="geometry" /></mxCell><mxCell id="dec_order_status" value="Order 'Chờ thanh toán'?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1270" y="745" width="300" height="85" as="geometry" /></mxCell><mxCell id="api_check_rehold" value="Kiểm tra giữ tồn kho; chuẩn bị khởi tạo giao dịch" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1240" y="855" width="360" height="70" as="geometry" /></mxCell><mxCell id="db_create_payment" value="Tạo bản ghi Payment (Chờ xử lý, hạn 15 phút, lưu Idempotency-Key)" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1710" y="855" width="420" height="70" as="geometry" /></mxCell><mxCell id="api_gen_url" value="Tạo URL VNPay Sandbox có thời hạn 15 phút kèm chữ ký SHA512" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1240" y="955" width="360" height="75" as="geometry" /></mxCell><mxCell id="api_auth_deny" value="Từ chối yêu cầu (401/403)" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="950" y="342" width="250" height="70" as="geometry" /></mxCell><mxCell id="dec_same_payload" value="Cùng Payload?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="965" y="540" width="220" height="85" as="geometry" /></mxCell><mxCell id="api_return_existing" value="Lấy URL thanh toán hiện có và trả về cho client" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="950" y="650" width="250" height="70" as="geometry" /></mxCell><mxCell id="api_conflict" value="Báo lỗi 409 Conflict: trùng Key khác payload" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="950" y="745" width="250" height="70" as="geometry" /></mxCell><mxCell id="api_reject_state" value="Từ chối tạo URL: đơn sai trạng thái/đã trả" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="950" y="855" width="250" height="70" as="geometry" /></mxCell><mxCell id="m_pay_err" value="" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="980" y="977" width="30" height="30" as="geometry" /></mxCell><mxCell id="ui_display_err" value="Hiển thị thông báo lỗi thanh toán trên giao diện" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="480" y="955" width="400" height="75" as="geometry" /></mxCell><mxCell id="end_err" value="" style="fontFamily=Arial;shape=doubleEllipse;fillColor=#111111;strokeColor=#111111;" vertex="1" parent="1"><mxGeometry x="666" y="1055" width="28" height="28" as="geometry" /></mxCell><mxCell id="m_ui_redir" value="" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="665" y="1115" width="30" height="30" as="geometry" /></mxCell><mxCell id="ui_redirect" value="Chuyển hướng trình duyệt sang cổng thanh toán VNPay Sandbox" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="480" y="1170" width="400" height="75" as="geometry" /></mxCell><mxCell id="vnp_serve" value="Hiển thị giao diện thanh toán Sandbox (môi trường thử nghiệm)" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2240" y="1170" width="400" height="75" as="geometry" /></mxCell><mxCell id="cus_enter_vnp" value="Khách hàng nhập thông tin thẻ test và xác nhận OTP Sandbox" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="1275" width="360" height="75" as="geometry" /></mxCell><mxCell id="vnp_process" value="Xử lý giao dịch thử nghiệm; ghi nhận kết quả tại cổng Sandbox" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2240" y="1275" width="400" height="75" as="geometry" /></mxCell><mxCell id="vnp_redirect_return" value="Chuyển hướng trình duyệt về Return URL kèm tham số kết quả" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2240" y="1385" width="400" height="75" as="geometry" /></mxCell><mxCell id="ui_receive_return" value="Tiếp nhận Return URL; gọi GET /orders/:id/payment-status" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="480" y="1385" width="400" height="75" as="geometry" /></mxCell><mxCell id="api_get_status" value="Đọc trạng thái Payment và Order từ Database; trả về cho client" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1120" y="1490" width="400" height="75" as="geometry" /></mxCell><mxCell id="ui_display_status" value="Hiển thị màn hình kết quả thanh toán cho khách hàng" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="480" y="1490" width="400" height="75" as="geometry" /></mxCell><mxCell id="cus_view_status" value="Khách hàng xem kết quả giao dịch và mã đơn hàng" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="1490" width="360" height="75" as="geometry" /></mxCell><mxCell id="end_return" value="" style="fontFamily=Arial;shape=doubleEllipse;fillColor=#111111;strokeColor=#111111;" vertex="1" parent="1"><mxGeometry x="216" y="1595" width="28" height="28" as="geometry" /></mxCell><mxCell id="vnp_send_ipn" value="Gửi Webhook IPN bất đồng bộ (Server-to-Server) đến NestJS API" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2240" y="1705" width="400" height="75" as="geometry" /></mxCell><mxCell id="api_receive_ipn" value="Tiếp nhận request IPN tại POST /payments/vnpay-ipn" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1120" y="1705" width="400" height="75" as="geometry" /></mxCell><mxCell id="dec_ipn_valid" value="Chữ ký và dữ liệu IPN hợp lệ?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1160" y="1810" width="320" height="85" as="geometry" /></mxCell><mxCell id="api_check_dup" value="IPN lặp (đã có kết quả cuối)?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1160" y="1925" width="320" height="85" as="geometry" /></mxCell><mxCell id="vnp_rsp_dup" value="Phản hồi RspCode 02 (Order already confirmed); không cập nhật DB" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1700" y="1925" width="420" height="85" as="geometry" /></mxCell><mxCell id="api_begin_ipn_tx" value="Mở DB Transaction; khóa Order và Payment để ghi nhận kết quả" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1120" y="2045" width="400" height="75" as="geometry" /></mxCell><mxCell id="dec_ipn_outcome" value="Kết quả giao dịch VNPay?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1160" y="2155" width="320" height="85" as="geometry" /></mxCell><mxCell id="db_ipn_success" value="Cập nhật Payment = Thành công; Order = Đã thanh toán; giữ nguyên tồn kho đã trừ" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1680" y="2080" width="460" height="85" as="geometry" /></mxCell><mxCell id="db_ipn_fail" value="Cập nhật Payment = Thất bại; hoàn tồn đúng một lần theo Product; giữ Order Chờ thanh toán" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1680" y="2195" width="460" height="85" as="geometry" /></mxCell><mxCell id="m_ipn_unknown" value="" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1645" y="2330" width="30" height="30" as="geometry" /></mxCell><mxCell id="db_ipn_unknown" value="Giữ Payment = Chờ xử lý; không hoàn tồn, không cho thanh toán lại; ghi nhận chờ đối soát" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1680" y="2305" width="460" height="85" as="geometry" /></mxCell><mxCell id="m_ipn_done" value="" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1895" y="2425" width="30" height="30" as="geometry" /></mxCell><mxCell id="db_commit_ipn" value="COMMIT Transaction cập nhật trạng thái" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1680" y="2480" width="460" height="75" as="geometry" /></mxCell><mxCell id="api_rsp_vnp" value="Phản hồi mã RspCode ('00' thành công / '97' lỗi) về cho VNPay Sandbox" style="fontFamily=Arial;