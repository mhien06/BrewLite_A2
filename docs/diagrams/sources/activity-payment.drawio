<mxfile host="app.diagrams.net" type="device"><diagram id="activity-payment" name="2. Chi tiết luồng khởi tạo và xử lý kết quả thanh toán"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2720" pageHeight="3200"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="2. Khởi tạo thanh toán VNPay Sandbox, Idempotency &amp; xử lý IPN (Activity Payment)" style="text;html=0;fontFamily=Arial;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="2680" height="50" as="geometry" /></mxCell><mxCell id="lane_cus" value="Khách hàng" style="swimlane;html=0;startSize=55;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=top;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="420" height="3090" as="geometry" /></mxCell><mxCell id="lane_ui" value="Next.js UI" style="swimlane;html=0;startSize=55;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=top;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="80" width="480" height="3090" as="geometry" /></mxCell><mxCell id="lane_api" value="NestJS API" style="swimlane;html=0;startSize=55;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=top;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="920" y="80" width="720" height="3090" as="geometry" /></mxCell><mxCell id="lane_db" value="Database" style="swimlane;html=0;startSize=55;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=top;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1640" y="80" width="540" height="3090" as="geometry" /></mxCell><mxCell id="lane_vnp" value="VNPay Sandbox «Payment Service»" style="swimlane;html=0;startSize=55;fontFamily=Arial;fontSize=20;fontStyle=1;align=center;verticalAlign=top;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2180" y="80" width="520" height="3090" as="geometry" /></mxCell><mxCell id="start_pay" value="" style="fontFamily=Arial;shape=ellipse;fillColor=#111111;strokeColor=#111111;" vertex="1" parent="1"><mxGeometry x="216" y="166" width="28" height="28" as="geometry" /></mxCell><mxCell id="cus_select_pay" value="Chọn phương thức VNPay Sandbox; bấm Thanh toán đơn hàng" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="230" width="360" height="75" as="geometry" /></mxCell><mxCell id="ui_gen_key" value="Sinh Idempotency-Key (UUIDv4); gửi POST /orders/:id/payments kèm JWT" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="480" y="230" width="400" height="75" as="geometry" /></mxCell><mxCell id="api_auth_check" value="Xác thực JWT &amp; quyền sở hữu Order?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1350" y="335" width="270" height="85" as="geometry" /></mxCell><mxCell id="api_auth_deny" value="Từ chối yêu cầu (401/403)" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="950" y="342" width="260" height="70" as="geometry" /></mxCell><mxCell id="api_query_key" value="Kiểm tra Idempotency-Key trong DB Cache/Table" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1340" y="440" width="280" height="70" as="geometry" /></mxCell><mxCell id="dec_key_exist" value="Key đã tồn tại?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1350" y="535" width="270" height="85" as="geometry" /></mxCell><mxCell id="dec_same_payload" value="Cùng Payload?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1020" y="535" width="220" height="85" as="geometry" /></mxCell><mxCell id="api_conflict" value="Báo lỗi 409 Conflict: trùng Key khác payload" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="935" y="645" width="190" height="80" as="geometry" /></mxCell><mxCell id="api_return_idempotent" value="Trả lại dữ liệu đã lưu theo trạng thái giao dịch: URL còn hạn / đang xử lý / kết quả cuối" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1130" y="645" width="210" height="85" as="geometry" /></mxCell><mxCell id="dec_idemp_state" value="URL thanh toán còn hạn?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1145" y="755" width="180" height="80" as="geometry" /></mxCell><mxCell id="api_query_order" value="Truy vấn Order và kiểm tra trạng thái thanh toán" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1350" y="860" width="280" height="70" as="geometry" /></mxCell><mxCell id="dec_order_status" value="Order 'Chờ thanh toán'?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1355" y="955" width="270" height="85" as="geometry" /></mxCell><mxCell id="api_reject_state" value="Từ chối tạo URL: đơn sai trạng thái hoặc đã thanh toán" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="950" y="960" width="260" height="75" as="geometry" /></mxCell><mxCell id="dec_no_pending_pay" value="Chưa có Payment Chờ xử lý / Chờ xác minh?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1350" y="1065" width="280" height="85" as="geometry" /></mxCell><mxCell id="api_reject_pending" value="Từ chối tạo thêm: đơn đang có giao dịch chờ xử lý" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="950" y="1070" width="260" height="75" as="geometry" /></mxCell><mxCell id="db_create_payment" value="Tạo bản ghi Payment (Chờ xử lý, hạn 15 phút, lưu Idempotency-Key); không trừ tồn kho lần 2" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1680" y="1175" width="460" height="80" as="geometry" /></mxCell><mxCell id="api_gen_url" value="Tạo URL VNPay Sandbox có thời hạn 15 phút kèm chữ ký SHA512" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1350" y="1178" width="280" height="80" as="geometry" /></mxCell><mxCell id="m_pay_err1" value="" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="870" y="720" width="30" height="30" as="geometry" /></mxCell><mxCell id="m_pay_err" value="" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="870" y="1092" width="30" height="30" as="geometry" /></mxCell><mxCell id="ui_display_err" value="Hiển thị thông báo lỗi thanh toán trên giao diện" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="480" y="1070" width="360" height="75" as="geometry" /></mxCell><mxCell id="end_err" value="" style="fontFamily=Arial;shape=doubleEllipse;fillColor=#111111;strokeColor=#111111;" vertex="1" parent="1"><mxGeometry x="646" y="1175" width="28" height="28" as="geometry" /></mxCell><mxCell id="m_ui_redir" value="" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="665" y="1275" width="30" height="30" as="geometry" /></mxCell><mxCell id="ui_redirect" value="Chuyển hướng trình duyệt sang cổng thanh toán VNPay Sandbox" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="480" y="1330" width="400" height="75" as="geometry" /></mxCell><mxCell id="vnp_serve" value="Hiển thị giao diện thanh toán Sandbox (môi trường thử nghiệm)" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2240" y="1330" width="400" height="75" as="geometry" /></mxCell><mxCell id="cus_enter_vnp" value="Khách hàng nhập thông tin thẻ test và xác nhận OTP Sandbox" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="1435" width="360" height="75" as="geometry" /></mxCell><mxCell id="vnp_process" value="Xử lý giao dịch thử nghiệm; ghi nhận kết quả tại cổng Sandbox" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2240" y="1435" width="400" height="75" as="geometry" /></mxCell><mxCell id="vnp_redirect_return" value="Chuyển hướng trình duyệt về Return URL kèm tham số kết quả" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2240" y="1545" width="400" height="75" as="geometry" /></mxCell><mxCell id="ui_receive_return" value="Tiếp nhận Return URL; gọi GET /orders/:id/payment-status" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="480" y="1545" width="400" height="75" as="geometry" /></mxCell><mxCell id="api_get_status" value="Đọc trạng thái Payment và Order từ Database; trả về cho client" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1120" y="1650" width="400" height="75" as="geometry" /></mxCell><mxCell id="m_ui_status" value="" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="665" y="1672" width="30" height="30" as="geometry" /></mxCell><mxCell id="ui_display_status" value="Hiển thị màn hình kết quả thanh toán cho khách hàng" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="480" y="1725" width="400" height="75" as="geometry" /></mxCell><mxCell id="cus_view_status" value="Khách hàng xem kết quả giao dịch và mã đơn hàng" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="1725" width="360" height="75" as="geometry" /></mxCell><mxCell id="end_return" value="" style="fontFamily=Arial;shape=doubleEllipse;fillColor=#111111;strokeColor=#111111;" vertex="1" parent="1"><mxGeometry x="216" y="1830" width="28" height="28" as="geometry" /></mxCell><mxCell id="vnp_send_ipn" value="Gửi Webhook IPN bất đồng bộ (Server-to-Server) đến NestJS API" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2240" y="1940" width="400" height="75" as="geometry" /></mxCell><mxCell id="api_receive_ipn" value="Tiếp nhận request IPN tại POST /payments/vnpay-ipn" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1120" y="1940" width="400" height="75" as="geometry" /></mxCell><mxCell id="dec_ipn_valid" value="Chữ ký và dữ liệu IPN hợp lệ?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1160" y="2045" width="320" height="85" as="geometry" /></mxCell><mxCell id="api_check_dup" value="IPN lặp (đã có kết quả cuối)?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1160" y="2160" width="320" height="85" as="geometry" /></mxCell><mxCell id="vnp_rsp_dup" value="Phản hồi RspCode 02 (Order already confirmed); không cập nhật DB" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1240" y="2270" width="380" height="80" as="geometry" /></mxCell><mxCell id="api_begin_ipn_tx" value="Mở DB Transaction; khóa Order và Payment để ghi nhận kết quả" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1040" y="2380" width="400" height="75" as="geometry" /></mxCell><mxCell id="dec_ipn_outcome" value="Kết quả giao dịch VNPay?" style="fontFamily=Arial;shape=rhombus;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1080" y="2490" width="320" height="85" as="geometry" /></mxCell><mxCell id="db_ipn_success" value="Cập nhật Payment = Thành công; Order = Đã thanh toán; giữ nguyên tồn kho đã trừ" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1680" y="2415" width="460" height="85" as="geometry" /></mxCell><mxCell id="db_ipn_fail" value="Cập nhật Payment = Thất bại; hoàn tồn đúng một lần theo Product; giữ Order Chờ thanh toán" style="fontFamily=Arial;rounded=1;arcSize=12;fillColor=#ffffff;strokeColor=#111111;strokeWidth=1.6;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1680" y="2530" width="460" height="85" as="geometry" /></mxCell><mxCell id="m_ipn_unknown" value="" style="fontFamily=Arial;shape