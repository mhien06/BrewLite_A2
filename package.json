    "db:migrate": "pnpm --filter @brewlite/api db:migrate"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.2",
    "typescript-eslint": "^8.72.1"
  }
}
