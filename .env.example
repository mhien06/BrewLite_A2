POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_PORT=5434
DATABASE_URL=postgresql://postgres:replace-with-local-database-password@localhost:5434/brewlite_a2
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=3600
API_PORT=3003
WEB_PORT=3002
FRONTEND_URL=http://localhost:3002
# Chỉ nhập thông tin Sandbox riêng của A2 trong .env, không dùng tài khoản A1.
VNPAY_TMN_CODE=YOUR_A2_CODE
VNPAY_HASH_SECRET=replace-with-a2-sandbox-secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:3002/payment/return
VNPAY_QUERY_IP=127.0.0.1
# Đăng ký URL HTTPS công khai này ở Merchant A2; biến này không tự đăng ký với VNPay.
VNPAY_IPN_URL=https://your-a2-tunnel.example/payments/vnpay/ipn
PAYMENT_RECONCILIATION_ENABLED=true
